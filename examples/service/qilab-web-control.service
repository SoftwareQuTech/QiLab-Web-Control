# Minimal example: runs directly from a source checkout with the system
# Python, no venv. The self-update route (see README.md "Self-update")
# requires the versioned releases/<version>/venv + `current` symlink layout
# from README's "Debian deployment" section — it is not available in this
# simpler mode.
[Unit]
Description=Qilab Web Control (FastAPI)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory= .
ExecStart=python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
